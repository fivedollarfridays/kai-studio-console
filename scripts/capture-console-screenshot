#!/usr/bin/env python3
"""scripts/capture-console-screenshot — regenerate docs/console.png.

Runs ``./demo`` on the committed sample (skipped if ``demo-out/`` already
holds a run), serves it with ``kai_slice.serve`` on an OS-assigned loopback
port, and uses headless Chromium (Playwright) to screenshot the console in
"local run" mode at a fixed viewport. ``page.screenshot()`` captures only the
page content -- no browser chrome, so no hostname or URL ever enters the
image -- and the ingest panel's one-time clock fact (the judge's own
"clock started <date> UTC" line, the single wall-clock-shaped text the page
renders) is removed via `Element.remove()` before the shot, so the image
never goes stale. No file path is shown anywhere in the UI.

Requires ``pip install playwright && playwright install chromium`` (not a
runtime dependency of ``kai_slice`` itself -- see the ``screenshot`` extra in
``pyproject.toml``). Not wired into the test suite or CI: regenerate by hand
whenever the console UI changes, and commit the result.
"""

from __future__ import annotations

import argparse
import subprocess
import sys
import threading
from pathlib import Path

_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(_ROOT))

from kai_slice.serve import make_server  # noqa: E402

VIEWPORT = {"width": 1200, "height": 660}
DEFAULT_OUT = _ROOT / "docs" / "console.png"
DEMO_OUT = _ROOT / "demo-out"

# Removed (never styled) before the screenshot: the ingest panel's facts list
# holds the one clock-shaped text the page renders ("clock started <date>
# UTC"). `Element.remove()` touches no `style` attribute, so it needs no CSP
# loosening beyond what `kai_slice/serve.py` already ships.
_HIDE_SELECTOR = 'section[aria-label="ingest"] dl'


def _ensure_demo_out() -> None:
    if (DEMO_OUT / "console" / "ingest.json").is_file():
        return
    rc = subprocess.run([str(_ROOT / "demo")], cwd=_ROOT, check=False).returncode
    if rc != 0:
        raise SystemExit(f"./demo exited {rc} -- run ./scripts/fetch-model first")


def _capture(port: int, out: Path) -> None:
    from playwright.sync_api import sync_playwright

    with sync_playwright() as pw:
        browser = pw.chromium.launch()
        try:
            page = browser.new_page(viewport=VIEWPORT)
            page.goto(f"http://127.0.0.1:{port}/")
            page.get_by_role("button", name="local run").click()
            page.wait_for_selector("text=camera A")
            page.evaluate(f"document.querySelector('{_HIDE_SELECTOR}').remove()")
            page.wait_for_timeout(200)
            out.parent.mkdir(parents=True, exist_ok=True)
            page.screenshot(path=str(out))
        finally:
            browser.close()


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--out", type=Path, default=DEFAULT_OUT, help="PNG destination")
    args = parser.parse_args(argv)

    _ensure_demo_out()
    httpd = make_server(DEMO_OUT, host="127.0.0.1", port=0)
    thread = threading.Thread(target=httpd.serve_forever, daemon=True)
    thread.start()
    try:
        _capture(httpd.server_port, args.out)
    finally:
        httpd.shutdown()
        httpd.server_close()
        thread.join(timeout=5)
    print(f"wrote {args.out}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
